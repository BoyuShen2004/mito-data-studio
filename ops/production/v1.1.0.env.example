# Non-secret contract for production_integrated_v1. Secrets, database password,
# metrics token and identity fingerprint are supplied only in the protected
# deployment .env.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mito-data-agent.seg.bio,127.0.0.1,localhost
DJANGO_CORS_ORIGINS=https://mito-data-agent.seg.bio
DJANGO_CSRF_TRUSTED_ORIGINS=https://mito-data-agent.seg.bio
MITO_ALLOW_DEV_RESET=0
ENABLE_MOCK_DEV_LOGIN=false
MOCK_DEV_LOGIN_ACCOUNTS=
MITO_MAINTENANCE_MODE=false
MITO_RESET_BACKUP_MARKER=
MITO_RESET_BACKUP_MAX_AGE_SECONDS=86400
MITO_RESET_ADMIN_USERNAME=admin

MITO_UPGRADE_PROFILE=production_integrated_v1
VITE_MITO_UPGRADE_PROFILE=production_integrated_v1
VITE_FEATURE_CHUNK_PULL_QUEUE=true
VITE_FEATURE_CHUNK_RENDERER=true

# Do not normally set individual FEATURE_* values. The production profile
# enables pyramids/chunks and the SPA declarations above compile in PullQueue
# and the chunk renderer. For an emergency transport rollback only, set both
# backend flags plus both Vite declarations false and rebuild/restart; source
# slice reads remain available.

MITO_DB_ENGINE=postgres
MITO_DB_CONN_MAX_AGE=60
MITO_PROCESSING_BACKEND=local
MITO_LOCAL_EXECUTABLE_ALLOWLIST=
MITO_PROCESSING_ENV_ALLOWLIST=

MITO_PROOFREADING_PROVIDER=inapp
MITO_VISUALIZATION_PROVIDER=inapp
MITO_QC_PROVIDER=basic
MITO_PUBLISHING_PROVIDER=placeholder
MITO_TRACKING_PROVIDER=sam2
# Keep the heavy SAM2 video model and interactive EfficientSAM sessions on
# separate RTX devices. The production check enforces this audited split.
MITO_SAM2_CUDA_DEVICE=0
MITO_AI_ONNX_CUDA=1
MITO_AI_CUDA_DEVICE=1
# Per-phase cache/encode/decode and Track parent timings in the service log.
MITO_AI_TIMING=1

MITO_TRUST_PROXY_SSL_HEADER=1
MITO_SECURE_SSL_REDIRECT=1
MITO_SESSION_COOKIE_SECURE=1
MITO_CSRF_COOKIE_SECURE=1
MITO_SECURE_HSTS_SECONDS=300
MITO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
MITO_SECURE_HSTS_PRELOAD=0
MITO_SECURE_NOSNIFF=1
MITO_USE_X_FORWARDED_HOST=0
MITO_READY_MIN_FREE_BYTES=53687091200
