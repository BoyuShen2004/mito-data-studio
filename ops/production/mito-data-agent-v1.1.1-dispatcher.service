[Unit]
Description=Mito Data Agent production v1.1.1 processing dispatcher
After=network.target docker.service mito-data-agent-v1.1.1.service
Requires=docker.service

[Service]
Type=simple
User=mito-production-v11
Group=mito-production-v11
WorkingDirectory=/home/weidf/shenb/mito-data-agent-production-v1.1.1/backend
EnvironmentFile=/home/weidf/shenb/mito-data-agent-production-v1.1.1/.env
ExecStart=/home/weidf/shenb/mito-data-agent-production-v1.1.1/venv/bin/python manage.py run_processing_dispatcher --interval 5 --max-new 2 --job-type build_pyramid
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/weidf/shenb/mito-data-agent-production-v1.1.1
ReadOnlyPaths=/home/weidf/shenb/data
ReadOnlyPaths=/home/weidf/shenb/wk_data
ReadOnlyPaths=/home/weidf/shenb/mito-data-agent-validation-source-v1.1.0
ReadWritePaths=/home/weidf/shenb/mito-data-agent-production-v1.1.1/var/data
ReadWritePaths=/home/weidf/shenb/mito-data-agent-production-v1.1.1/logs
ReadWritePaths=/home/weidf/shenb/mito-data-agent-production-v1.1.1/run
UMask=0027

[Install]
WantedBy=multi-user.target
