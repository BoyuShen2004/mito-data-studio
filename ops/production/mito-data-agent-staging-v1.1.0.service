[Unit]
Description=Mito Data Agent production-data staging v1.1.0
After=network.target docker.service
Requires=docker.service

[Service]
Type=notify
User=mito-staging-v11
Group=mito-staging-v11
WorkingDirectory=/home/weidf/shenb/mito-data-agent-staging-v1.1.0/backend
EnvironmentFile=/home/weidf/shenb/mito-data-agent-staging-v1.1.0/.env
ExecStart=/home/weidf/shenb/mito-data-agent-staging-v1.1.0/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18192 --workers 3 --threads 2 --timeout 300 --worker-tmp-dir /home/weidf/shenb/mito-data-agent-staging-v1.1.0/run --no-control-socket --access-logfile /home/weidf/shenb/mito-data-agent-staging-v1.1.0/logs/access.log --error-logfile /home/weidf/shenb/mito-data-agent-staging-v1.1.0/logs/error.log --pid /home/weidf/shenb/mito-data-agent-staging-v1.1.0/run/gunicorn.pid --capture-output
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=330
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/weidf/shenb/mito-data-agent-staging-v1.1.0
ReadOnlyPaths=/home/weidf/shenb/data
ReadOnlyPaths=/home/weidf/shenb/wk_data
ReadWritePaths=/home/weidf/shenb/mito-data-agent-staging-data-v1.1.0
ReadWritePaths=/home/weidf/shenb/mito-data-agent-staging-v1.1.0/logs
ReadWritePaths=/home/weidf/shenb/mito-data-agent-staging-v1.1.0/run
UMask=0027

[Install]
WantedBy=multi-user.target
