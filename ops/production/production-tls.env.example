# Public production profile for the Cloudflare tunnel -> loopback gunicorn
# topology. Secrets, database values, paths, and release identity are omitted.
# Apply only during the future cutover after Cloudflare "Always Use HTTPS" is
# enabled and the private release service has passed its authenticated smoke.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=mito-data-agent.seg.bio,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://mito-data-agent.seg.bio

# The origin is loopback-only and receives X-Forwarded-Proto from cloudflared.
MITO_TRUST_PROXY_SSL_HEADER=1
MITO_USE_X_FORWARDED_HOST=0
MITO_SECURE_SSL_REDIRECT=1
MITO_SESSION_COOKIE_SECURE=1
MITO_CSRF_COOKIE_SECURE=1
MITO_SECURE_NOSNIFF=1

# Begin with a five-minute HSTS observation window. Do not include all
# seg.bio subdomains and do not request browser preload during RC cutover.
MITO_SECURE_HSTS_SECONDS=300
MITO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
MITO_SECURE_HSTS_PRELOAD=0
