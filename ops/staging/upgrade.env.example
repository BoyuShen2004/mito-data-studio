# Overlay for an isolated full-stack upgrade candidate. Apply after the normal
# staging environment; never copy this over the frozen production v1.0.0 env.
MITO_UPGRADE_PROFILE=webknossos
VITE_MITO_UPGRADE_PROFILE=webknossos

# The parity staging base declares every backend flag false. Explicit values
# override the profile, so the full-candidate overlay must replace each one;
# omitting these lines would produce a build labelled "webknossos" whose
# server still behaved like v1.0.0.
FEATURE_TEAMS=true
FEATURE_AUTO_FILL_SCHEDULER=true
FEATURE_REVIEW_HISTORY=true
FEATURE_DASHBOARDS=true
FEATURE_ANNOTATION_OPS=true
FEATURE_INTERPOLATION=true
FEATURE_ANNOTATION_TOOLS=true
FEATURE_VOLUME_PYRAMIDS=true
FEATURE_CHUNK_SERVICE=true

# Explicit declarations keep deployment identity and frontend build honest.
VITE_FEATURE_CHUNK_PULL_QUEUE=true
VITE_FEATURE_CHUNK_RENDERER=true
