# Secrets and database credentials are deliberately omitted. The real staging
# file is `.env` (mode 0600, owned by the dedicated runtime user).
DJANGO_DEBUG=false
# Demo login wipe+reseed without turning on full Django DEBUG.
MITO_ALLOW_DEV_RESET=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ORIGINS=http://127.0.0.1:18189
# Include every TLS origin used for browser-backed private validation. Django
# admin mutations are session/CSRF protected even when API token login works.
DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1:18194
MITO_DATA_ROOT=/home/weidf/shenb/mito-data-agent-staging-20260731/data
MITO_DB_ENGINE=postgres
MITO_DB_NAME=mito_staging
MITO_DB_HOST=127.0.0.1
MITO_DB_PORT=5434
MITO_SERVICE_BIND=127.0.0.1:18189
MITO_RELEASE=mito-data-agent-v1.0.0-rc1
MITO_EXPECTED_CHECKOUT=/home/weidf/shenb/mito-data-agent-staging-20260731
MITO_EXPECTED_DATA_ROOT=/home/weidf/shenb/mito-data-agent-staging-20260731/data
MITO_EXPECTED_DB_NAME=mito_staging
MITO_EXPECTED_BIND=127.0.0.1:18189
MITO_TRUST_PROXY_SSL_HEADER=0
MITO_SESSION_COOKIE_SECURE=0
MITO_CSRF_COOKIE_SECURE=0
MITO_SECURE_SSL_REDIRECT=0
MITO_SECURE_HSTS_SECONDS=0
MITO_SECURE_NOSNIFF=1
MITO_PROCESSING_BACKEND=local
MITO_QC_PROVIDER=basic
MITO_PROOFREADING_PROVIDER=inapp
MITO_VISUALIZATION_PROVIDER=inapp
MITO_PUBLISHING_PROVIDER=placeholder
MITO_TRACKING_PROVIDER=sam2

# Initial staging run: exact production-parity defaults.
FEATURE_TEAMS=0
FEATURE_AUTO_FILL_SCHEDULER=0
FEATURE_REVIEW_HISTORY=0
FEATURE_DASHBOARDS=0
FEATURE_ANNOTATION_OPS=0
FEATURE_INTERPOLATION=0
FEATURE_ANNOTATION_TOOLS=0
FEATURE_VOLUME_PYRAMIDS=0
FEATURE_CHUNK_SERVICE=0
VITE_FEATURE_CHUNK_PULL_QUEUE=false
VITE_FEATURE_CHUNK_RENDERER=false
# Keep click-to-fill seed_dev login chips on staging/demo deploys.
# `frontend` `npm run build` also sets this; do not drop unless explicitly asked.
VITE_SHOW_DEMO_ACCOUNTS=true
