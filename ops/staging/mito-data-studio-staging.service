[Unit]
Description=Mito Data Studio isolated staging 20260731
After=network.target docker.service
Requires=docker.service

[Service]
Type=notify
User=mito-staging
Group=mito-staging
WorkingDirectory=/home/weidf/shenb/mito-data-studio-staging-20260731/backend
EnvironmentFile=/home/weidf/shenb/mito-data-studio-staging-20260731/.env
ExecStart=/home/weidf/shenb/mito-data-studio-staging-20260731/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18189 --workers 3 --threads 2 --timeout 300 --worker-tmp-dir /home/weidf/shenb/mito-data-studio-staging-20260731/run --no-control-socket --access-logfile /home/weidf/shenb/mito-data-studio-staging-20260731/logs/access.log --error-logfile /home/weidf/shenb/mito-data-studio-staging-20260731/logs/error.log --pid /home/weidf/shenb/mito-data-studio-staging-20260731/run/gunicorn.pid --capture-output
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=330
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/weidf/shenb/wk_data
ReadWritePaths=/home/weidf/shenb/mito-data-studio-staging-20260731/data
ReadWritePaths=/home/weidf/shenb/mito-data-studio-staging-20260731/logs
ReadWritePaths=/home/weidf/shenb/mito-data-studio-staging-20260731/run
UMask=0027

[Install]
WantedBy=multi-user.target
