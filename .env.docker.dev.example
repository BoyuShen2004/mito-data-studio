# Mito Data Studio — Docker development stack (.env.docker.dev)
#
# Full app + PostgreSQL without conda on the host. For live-reload development
# against a host checkout, use `.env` + docker-compose.dev.yml + `make dev`.
#
#   cp .env.docker.dev.example .env.docker.dev
#   ops/docker/detect-hardware.sh --apply .env.docker.dev
#   docker compose -f docker-compose.dev-stack.yml --env-file .env.docker.dev up -d --build
#
# GPU profile:
#   docker compose -f docker-compose.dev-stack.yml --env-file .env.docker.dev \
#     --profile gpu up -d --build app-gpu
#
# .env.docker.dev is gitignored.


# ============================================================================
# REQUIRED
# ============================================================================

DJANGO_SECRET_KEY=
MITO_DB_PASSWORD=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MITO_HOST_DATA_DIR=./data


# ============================================================================
# Serving (development defaults)
# ============================================================================

MITO_HOST_PORT=8000
DJANGO_DEBUG=true

# Leave probe-managed values unset when auto-tune is enabled. Uncommenting any
# one makes it an explicit override that the entrypoint will preserve.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
GUNICORN_TIMEOUT=300

# When 1, entrypoint probes CPU/RAM/GPU and fills unset sizing vars below.
# Run `ops/docker/detect-hardware.sh` on the host first to preview values.
MITO_HARDWARE_AUTO_TUNE=1


# ============================================================================
# Build
# ============================================================================

# core | ai-cpu | ai-gpu — use ai-gpu with --profile gpu
# MITO_DEPS=core
FRONTEND_BUILD_SCRIPT=build
APP_UID=1000
APP_GID=1000
MITO_HOST_VENDOR_DIR=./vendor


# ============================================================================
# Database
# ============================================================================

MITO_DB_NAME=mito_dev
MITO_DB_USER=mito


# ============================================================================
# Track / SAM2 — tune per machine (detect-hardware.sh suggests starting points)
# ============================================================================

MITO_UPGRADE_PROFILE=legacy
MITO_TRACKING_PROVIDER=sam2

# GPU index for SAM2 Track. With 2 GPUs, leave EfficientSAM on the other device.
# MITO_SAM2_CUDA_DEVICE=0
# MITO_AI_CUDA_DEVICE=1

# Max voxels in one Propagate-all slab (z × y × x). Lower on small-RAM hosts.
# MITO_TRACK_PLAN_MAX_VOXELS=256000000

# SAM2 XY crop window (pixels). Larger = more VRAM, often faster on big GPUs.
# MITO_SAM2_XY_PAD=256
# MITO_SAM2_XY_MIN=512
# MITO_SAM2_XY_MAX=2048

# CPU threads for numpy/scipy merge steps between GPU passes
# OMP_NUM_THREADS=8


# ============================================================================
# Dev accounts (optional)
# ============================================================================

ENABLE_MOCK_DEV_LOGIN=true
MOCK_DEV_LOGIN_ACCOUNTS=manager,annotator,requester
MOCK_DEV_LOGIN_PASSWORD=demo12345

# Uncomment for automatic admin on first start:
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.org
# DJANGO_SUPERUSER_PASSWORD=admin12345


# ============================================================================
# Features
# ============================================================================

FEATURE_VOLUME_PYRAMIDS=1
FEATURE_CHUNK_SERVICE=1
MITO_READY_MIN_FREE_BYTES=1073741824
