# Copy to .env (`make setup` does this on first run). Loaded by
# backend/config/settings.py.

# Live data root — prefer OUTSIDE the git checkout so volumes/annotations
# never get committed. ./data is gitignored and fine for a quick start.
MITO_DATA_ROOT=./data
# MITO_DATA_ROOT=../mito-data-studio-data

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=true
# Login-page Development accounts reset. It requires this switch plus
# ENABLE_MOCK_DEV_LOGIN and a non-empty disposable account allowlist.
# MITO_ALLOW_DEV_RESET=0
ENABLE_MOCK_DEV_LOGIN=false
# Comma-separated disposable accounts and their server-configured click-to-fill
# password. Never use this password for a real user or valuable data.
MOCK_DEV_LOGIN_ACCOUNTS=
MOCK_DEV_LOGIN_PASSWORD=
# Destructive reset stays unavailable until an operator enables maintenance
# and points at a fresh, verified backup marker.
MITO_MAINTENANCE_MODE=false
MITO_RESET_BACKUP_MARKER=
MITO_RESET_BACKUP_MAX_AGE_SECONDS=86400
MITO_RESET_ADMIN_USERNAME=admin
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Providers -------------------------------------------------------------
# `inapp` = this app's own slice viewer (/viewer/...) and annotation editor
# (/editor/tasks/<id>). Setting either to `placeholder` turns the View /
# Annotate entry points into "no provider configured" — only do that if you
# are wiring an external tool (e.g. Neuroglancer) instead.
MITO_QC_PROVIDER=basic
MITO_PROOFREADING_PROVIDER=inapp
MITO_VISUALIZATION_PROVIDER=inapp
MITO_PUBLISHING_PROVIDER=placeholder

# SAM2 tracking: "sam2" uses vendor/sam2 (hiera_large). Needs the conda env
# from environment.yml (pytorch + CUDA). Use "local" only for CPU-only CI.
MITO_TRACKING_PROVIDER=sam2
# Defaults already point at vendor/ — override only if weights live elsewhere:
# MITO_SAM2_ROOT=./vendor/sam2
# MITO_SAM2_CHECKPOINT=./vendor/sam2/checkpoints/sam2.1_hiera_large.pt
# MITO_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
# MITO_SAM2_CUDA_DEVICE=0
# MITO_AI_ONNX_CUDA=1
# MITO_AI_CUDA_DEVICE=1
# MITO_AI_TIMING=1
# MITO_CELLABLE_MODELS_ROOT=./vendor/efficient_sam
# MITO_EFFICIENT_SAM_VARIANT=vits

# --- Database (local development only) -------------------------------------
# "postgres" (primary; start it with `docker compose -f docker-compose.dev.yml
# up -d`) or "sqlite" (lightweight fallback, no row locking). Concurrency tests
# require PostgreSQL; SQLite cannot reproduce row-locking behavior.
# Generate your own password; never reuse a deployment's.
MITO_DB_ENGINE=postgres
MITO_DB_NAME=mito_dev
MITO_DB_USER=mito
MITO_DB_PASSWORD=change-me-locally
MITO_DB_HOST=127.0.0.1
MITO_DB_PORT=5433

# --- Feature flags ---------------------------------------------------------
# `legacy` preserves v1.0.0. `webknossos` enables every development phase.
# `production_integrated_v1` is the fixed v1.1 production contract and rejects
# individual FEATURE_* drift; use ops/production/v1.1.0.env.example for it.
MITO_UPGRADE_PROFILE=legacy
MITO_METRICS_BEARER_TOKEN=
MITO_READY_MIN_FREE_BYTES=1073741824
MITO_LOCAL_EXECUTABLE_ALLOWLIST=
MITO_LOCAL_JOB_TIMEOUT_SECONDS=86400
MITO_PROCESSING_ENV_ALLOWLIST=nnUNet_raw,nnUNet_preprocessed,nnUNet_results,CUDA_VISIBLE_DEVICES,OMP_NUM_THREADS
# Team-based access control (Team / TeamMembership / AuditEvent). Off by default — the tables and services ship inert, so the
# migration can be applied and backfilled before any behaviour changes. Turn on
# only after projects have been granted teams, or team members lose nothing but
# gain nothing either.
FEATURE_TEAMS=0

# --- Processing / HPC ------------------------------------------------------
MITO_PROCESSING_BACKEND=local
# MITO_SHARED_STORAGE_ROOT=
# MITO_SLURM_PARTITION=
# MITO_SLURM_ACCOUNT=

# --- Optional bind (remote / HPC) ------------------------------------------
# DJANGO_HOST=127.0.0.1
# DJANGO_PORT=8000
# VITE_HOST=127.0.0.1
# VITE_PORT=5173
# NO_BROWSER=0

# Manager auto-fill scheduler (push assignment). With this off,
# `manage.py auto_fill` refuses and nothing is ever pushed. Run a tick with:
#   python manage.py auto_fill --dry-run     # propose, change nothing
#   python manage.py auto_fill               # apply
# Intended mechanism is cron; see docs/.../phases/PHASE-4-auto-fill-scheduler.md
FEATURE_AUTO_FILL_SCHEDULER=0
# Hard ceiling on assignments per tick — bounds the lock and the scan.
# MITO_SCHEDULER_MAX_BATCH=200
# An annotator must have been seen within this many days to receive pushed
# work. 0 disables the recency gate.
# MITO_SCHEDULER_ACTIVE_DAYS=14
# Deterministic scoring weights; each applies to a normalised 0..1 component.
# MITO_SCHED_W_PROJECT_PRIORITY=3.0
# MITO_SCHED_W_TASK_PRIORITY=2.0
# MITO_SCHED_W_DEADLINE=2.0
# MITO_SCHED_W_QUALITY=1.0
# MITO_SCHED_W_LOAD=2.0
# MITO_SCHED_W_FAIRNESS=1.5

# Phase 6 dashboards & statistics (read-only endpoints under /api/statistics/).
# Requires no other flag: with everything else off the project dashboard still
# reports task statuses and elapsed durations, and the instance chart is
# legitimately empty because no task instances exist.
# Note: "elapsed" figures are wall-clock time between recorded events, NOT time
# spent working — mito has no activity instrumentation. See ADR-004.
FEATURE_DASHBOARDS=0

# Phase 7 annotation operation log + work sessions (append-only history, undo,
# measured active time). Requires no other flag — the phase map places Phase 7
# on phases 0-1, not on the task hierarchy.
# The working label memmap stays authoritative for reads either way; the log is
# history and undo substrate, not the source of truth.
FEATURE_ANNOTATION_OPS=0
# Operation payloads are metadata, not voxels. Anything larger must be stored by
# reference (payload_ref) so the log stays scannable.
# MITO_OP_PAYLOAD_MAX_BYTES=16384
# Active time is measured from the SERVER clock only; client timestamps are
# diagnostic. A heartbeat credits at most this much, so a sleeping tab that
# wakes after an hour credits two minutes rather than an hour.
# MITO_SESSION_MAX_HEARTBEAT_SECONDS=120
# A gap longer than this credits nothing and starts a new active span.
# MITO_SESSION_IDLE_TIMEOUT_SECONDS=300

# Phase 8 interpolation (SDF blend between two labelled slices). Planning (the
# preview) needs only this flag; APPLYING also needs FEATURE_ANNOTATION_OPS,
# because one apply records exactly one Phase 7 operation — the "single
# undoable transaction" the spec asks for.
FEATURE_INTERPOLATION=0
# Hard ceiling on a request, counted as plane voxels x depth. Guards the
# float64 signed-distance intermediates (8 bytes per voxel each).
# MITO_INTERPOLATION_MAX_VOXELS=67108864

# Phase 9 annotation tools: the ranked P1 set from doc 19 — flood fill 2D/3D,
# overwrite policies, deep links. Planning needs only this flag; APPLYING also
# needs FEATURE_ANNOTATION_OPS, because an apply records one Phase 7 operation.
FEATURE_ANNOTATION_TOOLS=0
# Abuse limits, checked before allocation.
# MITO_TOOL_MAX_VOXELS=16777216
# "Limited 3D" from doc 19: a depth ceiling on top of the voxel cap, so a 3-D
# fill cannot quietly become a whole-volume flood.
# MITO_TOOL_MAX_FILL_DEPTH=32

# Phase 11 immutable Zarr v3 derivatives. Building is additive and never
# changes TIFF/HDF5/NIfTI sources. production_integrated_v1 defaults this on;
# explicit 0 remains the emergency rollback switch.
FEATURE_VOLUME_PYRAMIDS=1

# Phase 12 read-only chunk service. Requires FEATURE_VOLUME_PYRAMIDS.
FEATURE_CHUNK_SERVICE=1

# Phase 13 browser PullQueue/cache/data-source adapter. This is a Vite build
# flag, not a Django setting. production_integrated_v1 builds both paths on;
# disable both together with the two backend flags for emergency fallback.
VITE_FEATURE_CHUNK_PULL_QUEUE=true
VITE_FEATURE_CHUNK_RENDERER=true

# --- Mitochondria instance annotation, project management, quality ----------
# All four default to 0 so an existing deployment upgrades to identical
# behaviour and opts in one feature at a time. Every route is registered
# unconditionally and returns 503 when its flag is off, so a misconfiguration
# reads as "not enabled" rather than as a 404 typo.

# Per-instance morphology and QA flags (the Instance details panel in Annotate,
# plus the project Quality tab's instance summary). Purely additive: an absent
# row means "not annotated", which is what every existing volume already has.
FEATURE_INSTANCE_ANNOTATION=0

# The per-person inbox (the navbar bell and /inbox).
# NOTE: this gates the READ endpoints only. Notifications are written by the
# service layer regardless, so enabling this later reveals the history that
# accumulated rather than starting from an empty inbox.
FEATURE_NOTIFICATIONS=0

# Milestones plus the burndown / throughput / people / attention analytics on
# the project Delivery tab. Progress is recomputed from tasks on every read and
# never stored, so it cannot drift from the work it describes.
FEATURE_MILESTONES=0

# Dice/IoU and instance-level scoring (false merges, false splits, VI).
# Two sources, neither of which costs extra annotation: a gold-standard volume
# scored against an already-approved submission, and the difference between what
# an annotator submitted and what a reviewer actually approved.
FEATURE_QUALITY_METRICS=0
# How many recent gold-standard scores feed a person's rolling quality figure.
# Somebody with none reports "not measured", never 0.0.
# MITO_QUALITY_SCORE_WINDOW=10
# Mean Dice below this raises a quality.flagged notification to the managers.
# MITO_QUALITY_FLAG_THRESHOLD=0.80

# Two notification commands need a scheduler; neither has a triggering action.
#   daily:  python manage.py notify_deadlines --days 3
#   weekly: python manage.py prune_notifications --days 90
# The first is idempotent per (recipient, target, day), so an hourly cron
# cannot duplicate rows. The second deletes only *read* notifications past the
# window — an unread one is still owed to somebody, however old.
# See docs/deployment.md#scheduled-notification-tasks.
# Scoring runs from the service layer (on submit, and on approve), not from the
# QC provider registry — so MITO_QC_PROVIDER keeps its existing meaning and
# does not need changing for any of this.
