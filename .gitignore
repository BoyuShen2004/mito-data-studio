# Django — the live DB holds users (incl. mock/seed accounts), projects,
# datasets, volumes, tasks. Never push it.
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
media/
staticfiles/

# Live annotation data (MITO_DATA_ROOT). Prefer a path OUTSIDE this repo.
mito_data_root/
/data/
data/

# Runtime volume binaries if someone copies them into the tree by mistake.
# Vendor model weights (*.pt / *.onnx under vendor/) are tracked via Git LFS
# — see .gitattributes — and are NOT covered by these patterns' intent when
# force-added under vendor/; keep the patterns for accidental data copies.
*.tif
*.tiff
*.npy
*.nii
*.nii.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/node_modules/
frontend/.vite/
dist/

# dev-setup local state
.dev-cache/

# Test coverage / runtime logs / process files
coverage/
htmlcov/
.coverage
*.log
*.pid
/run/
/venv/

# Timestamped editor/tool backups (foo.py.backup.20260727-084845). Local
# safety nets, not history — git already is the history. Ignored rather than
# deleted: they are the author's own files to keep or bin.
*.backup.[0-9]*

# Environment / secrets
.env
.env.*
!.env.example
# The container deployment's env template. `.env.docker` itself (the real one,
# with the secret key and database password) stays ignored by `.env.*` above.
!.env.docker.example
!.env.docker.dev.example
*.pem

# Per-machine agent/tool overrides
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
*~

# Disposable runtime, uploads, mock fixtures and generated seed exports.
# Keep LoginPage and fixture-generator source tracked; outputs belong here.
/var/
logs/
run/
uploads/
fixtures/mock-data/
fixtures/generated/
mock-data/
test-output/
test-results/
playwright-report/
seed-dumps/
*.sqlite
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.sql
*.sql.gz
*.dump
*.dump.gz
*.h5
*.hdf5
*.npz
*.zarr/
*.n5/
.preview-manager.json
*seed-dump*.json
*seed-dump*.json.gz
# Existing reviewed algorithm golden fixtures are intentional product tests.
!backend/annotation/interpolation/golden/*.npz
!backend/annotation/tools/golden/*.npz
