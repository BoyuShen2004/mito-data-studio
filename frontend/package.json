{
  "name": "mito-data-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && VITE_SHOW_DEMO_ACCOUNTS=true vite build",
    "build:upgrade": "tsc --noEmit && VITE_MITO_UPGRADE_PROFILE=webknossos VITE_SHOW_DEMO_ACCOUNTS=true vite build",
    "build:production": "tsc --noEmit && VITE_MITO_UPGRADE_PROFILE=production_integrated_v1 VITE_FEATURE_CHUNK_PULL_QUEUE=true VITE_FEATURE_CHUNK_RENDERER=true VITE_SHOW_DEMO_ACCOUNTS=true vite build",
    "build:no-demo": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:phase13": "vitest run src/features/chunks/scrubBenchmark.test.ts --reporter=verbose --silent=false",
    "test:e2e:phase14": "playwright test",
    "bench:phase14": "playwright test --grep @phase14-benchmark"
  },
  "dependencies": {
    "@types/three": "^0.170.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
